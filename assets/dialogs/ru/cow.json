{
    "id": "Cow",
    "name": "Cow",
    "description": "",
    "dialogs": {
        "dialog-cow-idle": {
            "lines": [
                {
                    "name": "Большая Корова",
                    "text": "Муу! Муу! Муу!"
                },
                {
                    "name": "Рассказчик",
                    "text": "Это определённо обычная корова.",
                    "size": 20,
                    "color": [255, 255, 210, 255],
                    "align": "right"
                },
                {
                    "name": "Рассказчик",
                    "text": "Или нет?",
                    "size": 20,
                    "color": [255, 255, 210, 255],
                    "align": "right"
                },
                {
                    "name": "Сознание",
                    "text": "Может, она просто голодна.",
                    "size": 20,
                    "color": [255, 255, 210, 255],
                    "align": "right"
                }
            ]
        },
        "dialog-cow-quest-carrot": {
            "lines": [
                {
                    "name": "Большая Корова",
                    "text": "Муу! Муу! Муу!",
                    "size": 20,
                    "color": [255, 255, 255, 255],
                    "align": "left"
                },
                {
                    "name": "Рассказчик",
                    "text": "Вы стоите перед коровой — величественным, самодостаточным и поразительно независимым существом. Вы чувствуете её голод — глубокий и настойчивый. И знаете с абсолютной уверенностью, что где-то здесь, у вас в кармане, лежит морковка.",
                    "size": 20,
                    "color": [255, 255, 210, 255],
                    "align": "right"
                },
                {
                    "name": "Большая Корова",
                    "text": "Муу! Муу! Муу-у-у-у-у!",
                    "size": 20,
                    "color": [255, 255, 255, 255],
                    "align": "left"
                },
                {
                    "name": "Рассказчик",
                    "text": "Корова жуёт поднесённую морковь с полным самозабвением. Она довольна; вы чувствуете волну чистого, неподдельного счастья, исходящую из её глаз. Кажется... она благодарит вас. Кажется?",
                    "size": 20,
                    "color": [255, 255, 210, 255],
                    "align": "right"
                }
            ],
            "textSize": 20
        },
        "dialog-cow-quest-carrot-progress-1": {
            "lines": [
                {
                    "name": "Рассказчик",
                    "text": "Эти глаза... кажется, они смотрят прямо на вас. В них столько благодарности, что вы почти ощущаете её — как тёплые, успокаивающие объятия.",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "Большая Корова",
                    "text": "Муу! Муу! Муу-у-у-у-у!",
                    "size": 20,
                    "color": [255, 255, 255, 255],
                    "align": "left"
                }

            ],
            "textSize": 20
        },
        "dialog-cow-quest-carrot-progress-2": {
            "lines": [
                {
                    "name": "Рассказчик",
                    "text": "Она ищет что-то. Что-то, чего у вас пока нет.",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "Большая Корова",
                    "text": "Муу! Муу! Муу-у-у-у-у!",
                    "size": 20,
                    "color": [255, 255, 255, 255],
                    "align": "left"
                }
            ],
            "textSize": 20
        },
        "dialog-cow-quest-carrot-progress-3": {
            "lines": [
                {
                    "name": "Рассказчик",
                    "text": "Голодная, голодная корова.",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "Большая Корова",
                    "text": "Муу! Муу-у?",
                    "size": 20,
                    "color": [255, 255, 255, 255],
                    "align": "left"
                }
            ],
            "textSize": 20
        },
        "dialog-cow-quest-complete": {
            "lines": [
                {
                    "name": "Большая Корова",
                    "text": "*Радостное мычание* Муу! Муу! Муу!"
                }
            ],
            "textSize": 20
        },
        "dialog-cow-assembly-hall-1-no-carrot": {
            "lines": [
                {
                    "name": "Большая Корова",
