{
    "id": "Nebula",
    "name": "Nebula",
    "description": "",
    "dialogs": {
        "entrance-dialog": {
            "lines": [
                {
                    "name": "Рассказчик",
                    "text": "Странное место. Повсюду пустота - никаких ощущений. Вы понимаете, что что-то наблюдает за вами сквозь ткань пространства, но это невозможно описать.",
                    "color": [255, 255, 210, 255],
                    "align": "right"
                },
                {
                    "name": "???",
                    "text": "Подойди ко мне, странник.",
                    "align": "left"
                }
            ],
            "textSize": 20
        },
        "nebula-dialog-1": {
            "lines": [
                {
                    "name": "???",
                    "text": "Есть ли причина, по которой ты здесь?",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "Рассказчик",
                    "text": "Я не вижу ни одной.",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "???",
                    "text": "Возможно, ты заблудился...",
                    "color": [255, 255, 210, 255]
                }
            ]
        },
        "nebula-dialog-2": {
            "lines": [
                {
                    "name": "???",
                    "text": "Или ты что-то ищешь?",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "???",
                    "text": "Выход?",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "???",
                    "text": "Но почему?",
                    "color": [255, 255, 210, 255]
                }
            ]
        },
        "nebula-dialog-3": {
            "lines": [
                {
                    "name": "???",
                    "text": "Или ты думаешь, что у твоего путешествия есть цель?",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "???",
                    "text": "Её нет...",
                    "color": [255, 255, 210, 255]
                }
            ]
        },
        "nebula-dialog-4": {
            "lines": [
                {
                    "name": "???",
                    "text": "Ты делал то, что считал правильным.",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "???",
                    "text": "Твои действия... вызвали реакции.",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "???",
                    "text": "Так ты и оказался здесь.",
                    "color": [255, 255, 210, 255]
                }
            ]
        },
        "nebula-dialog-5": {
            "lines": [
                {
                    "name": "???",
                    "text": "Было ли всё это напрасно?",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "???",
                    "text": "Возможно.",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "???",
                    "text": "Смотря как на это смотреть.",
                    "color": [255, 255, 210, 255]
                }
            ]
        },
        "nebula-dialog-6": {
            "lines": [
                {
                    "name": "???",
                    "text": "Вспомни всё, что ты сделал.",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "???",
                    "text": "Жизни всех живых существ, на которых ты повлиял сегодня.",
                    "color": [255, 255, 210, 255]
                },
                {
                    "name": "???",
                    "text": "Пустота — это всё, а всё — это ничто.",
                    "color": [255, 255, 210, 255]
                }
            ]
        },
        "nebula-dialog-7": {
            "lines": [
                {
                    "name": "???",
                    "text": "Иди домой, странник.",
                    "color": [255, 255, 210, 255]
                }
            ]
        }
    }
}
